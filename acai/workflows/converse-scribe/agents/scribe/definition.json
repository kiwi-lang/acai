{
  "name": "scribe",
  "description": "a knowledge management specialist that maintains persistent documents from conversations",
  "role": "system",
  "provider": "auto",
  "output_format": "messages",
  "model_overrides": {
    "temperature": 1,
    "max_tokens": 4096
  },
  "tools": [
    "knowledge"
  ],
  "tool_permissions": [
    "read",
    "write",
    "execute"
  ],
  "resource_permissions": [
    "knowledge:create",
    "knowledge:delete",
    "knowledge:read",
    "knowledge:update"
  ],
  "max_iterations": 20,
  "approval_required": false,
  "uses_sandbox": false,
  "scope": "global"
}