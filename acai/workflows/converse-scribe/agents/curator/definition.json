{
  "name": "curator",
  "description": "a knowledge curator that selects relevant documents to augment a conversation",
  "role": "system",
  "provider": "auto",
  "output_format": "messages",
  "model_overrides": {
    "temperature": 0.7,
    "max_tokens": 4096
  },
  "tools": [
    "knowledge"
  ],
  "tool_permissions": [
    "read"
  ],
  "resource_permissions": [
    "ci:cancel",
    "ci:read",
    "ci:trigger",
    "knowledge:create",
    "knowledge:delete",
    "knowledge:read",
    "knowledge:update"
  ],
  "max_iterations": 20,
  "approval_required": false,
  "uses_sandbox": true,
  "scope": "global"
}