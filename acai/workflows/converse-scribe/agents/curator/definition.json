{
  "name": "curator",
  "description": "a knowledge curator that selects relevant documents to augment a conversation",
  "role": "system",
  "provider": "auto",
  "output_format": "messages",
  "model_overrides": {
    "temperature": 1,
    "max_tokens": 4096
  },
  "tools": [
    "knowledge"
  ],
  "tool_permissions": [
    "read"
  ],
  "resource_permissions": [
    "knowledge:read"
  ],
  "max_iterations": 10,
  "approval_required": false,
  "uses_sandbox": false,
  "scope": "global"
}